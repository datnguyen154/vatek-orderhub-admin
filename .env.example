# OrderHub Admin Console - Environment Variables
# Copy this file to .env.local for local development overrides.
# Do NOT commit actual secrets, keys, or credentials.

# API & Mocking (Session 09 / D10)
# Set to "enabled" to activate Mock Service Worker in the browser for client requests.
# Set to "disabled" to send requests to the real configured API path.
NEXT_PUBLIC_API_MOCKING=enabled

# Base URL for API calls (optional; defaults to relative same-origin if empty)
NEXT_PUBLIC_API_BASE_URL=

# Demo Auth Session Secret (Session 07 / D9)
# Must be a secure random string of at least 32 characters in length.
DEMO_SESSION_SECRET=replace-with-a-secure-random-string-at-least-32-chars-for-demo
