# OrderHub Admin Console - Environment Variables
# Copy this file to .env.local for local overrides.
# Do NOT commit actual secrets or credentials.

# API & Mocking
NEXT_PUBLIC_API_MOCKING=enabled
NEXT_PUBLIC_API_BASE_URL=

# Demo Auth Session Secret (used in server-side session signing - D9)
# Must be at least 32 characters long in production or local environments
DEMO_SESSION_SECRET=replace-with-a-secure-random-string-at-least-32-chars-for-demo
